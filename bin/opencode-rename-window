#!/usr/bin/env bash
set -euo pipefail

# Name tmux windows after the opencode agent running in their active pane.
# Status comes from the TUI bridge records under $RUNTIME_DIR (same contract as
# bin/opencode-agents); no bridge record means the window is left untouched.

RUNTIME_BASE="${XDG_RUNTIME_DIR:-/tmp/opencode-dashboard-$UID}"
RUNTIME_DIR="$RUNTIME_BASE/opencode-dashboard"
MARKER_FILE="$RUNTIME_DIR/tmux-named-windows"
STALE_AFTER_MS=5000
TITLE_MAX=40
RUNNING_FRAMES=('⣶' '⣧' '⣏' '⡟' '⠿' '⢻' '⣹' '⣼')
BLOCKED_FRAMES=('·' '·' '·' '·' '⚠' '·' '·' '⚠' '·')

SESSION_ID="${1:-}"

command -v tmux >/dev/null 2>&1 || exit 0
command -v jq >/dev/null 2>&1 || exit 0
[[ -d "$RUNTIME_DIR" ]] || exit 0

now=$(date +%s%3N)

# Collect the freshest live bridge record per tty.
shopt -s nullglob
declare -A records=()
declare -A heartbeats=()

for file in "$RUNTIME_DIR"/tui-*.json; do
    record=$(jq -c 'select(.schema == 1 and (.pid | type == "number") and ((.rootSessionID // "") | length > 0))' "$file" 2>/dev/null || true)
    [[ -n "$record" ]] || continue

    pid=$(jq -r '.pid' <<<"$record")
    [[ -d "/proc/$pid" ]] || continue

    process_ticks=$(awk '{print $22}' "/proc/$pid/stat" 2>/dev/null || true)
    expected_ticks=$(jq -r '.processStartTicks // ""' <<<"$record")
    [[ -n "$process_ticks" && "$process_ticks" == "$expected_ticks" ]] || continue

    tty=$(jq -r '.tty // ""' <<<"$record")
    [[ -n "$tty" ]] || continue

    heartbeat=$(jq -r '.heartbeatAt // 0' <<<"$record")
    if [[ -z ${records[$tty]:-} ]] || ((heartbeat > heartbeats[$tty])); then
        records[$tty]="$record"
        heartbeats[$tty]="$heartbeat"
    fi
done

panes=$(tmux list-panes ${SESSION_ID:+-t "$SESSION_ID"} -F '#{window_id},#{pane_tty},#{pane_active}' 2>/dev/null) || exit 0
[[ -n "$panes" ]] || exit 0

declare -A seen=()
declare -A named=()

while IFS=',' read -r window_id tty active; do
    [[ "$active" == "1" ]] || continue
    seen[$window_id]=1

    record=${records[$tty]:-}
    [[ -n "$record" ]] || continue

    state=$(jq -r '.state // "unknown"' <<<"$record")
    heartbeat=${heartbeats[$tty]:-0}
    if (( now - heartbeat > STALE_AFTER_MS )); then
        state='unknown'
    fi

    case "$state" in
        running) glyph=${RUNNING_FRAMES[$(( (now / 200) % ${#RUNNING_FRAMES[@]} ))]} ;;
        blocked) glyph=${BLOCKED_FRAMES[$(( (now / 180) % ${#BLOCKED_FRAMES[@]} ))]} ;;
        idle) glyph='✓' ;;
        pending) glyph='!' ;;
        *) glyph='?' ;;
    esac

    title=$(jq -r '.title // ""' <<<"$record")
    case "$title" in
        "New session"*) title="opencode" ;;
    esac
    [[ -n "$title" ]] || title="opencode"
    title="${title:0:$TITLE_MAX}"

    name="[${glyph}] ${title}"
    window_name=$(tmux display-message -t "$window_id" -p '#{window_name}' 2>/dev/null) || window_name=''
    if [[ "$name" != "$window_name" ]]; then
        tmux rename-window -t "$window_id" "$name" 2>/dev/null || true
    fi
    named[$window_id]=1
done <<<"$panes"

# Revert marked windows whose agent is gone back to automatic naming.
if [[ -f "$MARKER_FILE" ]]; then
    while IFS= read -r window_id; do
        [[ -n "$window_id" ]] || continue
        [[ -n ${seen[$window_id]:-} ]] || continue
        [[ -n ${named[$window_id]:-} ]] && continue
        tmux rename-window -t "$window_id" "" 2>/dev/null || true
    done < "$MARKER_FILE"
fi

# Persist the marker with the windows named this cycle.
if [[ ${#named[@]} -gt 0 ]]; then
    mkdir -p -m 700 "$RUNTIME_DIR" 2>/dev/null || true
    : > "$MARKER_FILE.tmp"
    for window_id in "${!named[@]}"; do
        printf '%s\n' "$window_id" >> "$MARKER_FILE.tmp"
    done
    mv "$MARKER_FILE.tmp" "$MARKER_FILE" 2>/dev/null || true
elif [[ -f "$MARKER_FILE" ]]; then
    rm -f "$MARKER_FILE" 2>/dev/null || true
fi
