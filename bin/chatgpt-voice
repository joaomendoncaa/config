#!/usr/bin/env bash
set -euo pipefail

# chatgpt-voice — Open ChatGPT voice mode in a new window of the regular
# Helium browser (default profile, so you stay logged in) and control it via CDP.
#
# Requires: helium browser (/opt/helium-browser-bin/helium),
#           python3 with websockets

HELIUM=/opt/helium-browser-bin/helium
DEBUG_PORT=9223
CHATGPT_URL="https://chatgpt.com"

# CDP needs the debug port at browser startup, and Chromium (Helium) only
# allows one instance per profile. So stop any running Helium, then relaunch
# it with the port on the default profile (same login), restoring the session.
if pgrep -x helium >/dev/null 2>&1; then
    echo "Helium is running — restarting it with the debug port (session will be restored)"
    pkill -x helium
    for _ in $(seq 1 20); do
        pgrep -x helium >/dev/null 2>&1 || break
        sleep 0.5
    done
fi

"$HELIUM" \
    --remote-debugging-port=$DEBUG_PORT \
    --restore-last-session \
    --no-first-run \
    --no-default-browser-check \
    --new-window \
    "$CHATGPT_URL" &
HELIUM_PID=$!

# Wait for CDP endpoint to come up
for _ in $(seq 1 40); do
    if curl -sf "http://localhost:$DEBUG_PORT/json/version" >/dev/null 2>&1; then
        break
    fi
    sleep 0.5
done

# Use CDP to control the browser
python3 << 'PYEOF'
import asyncio
import json
import urllib.request
import sys

try:
    import websockets
except ImportError:
    print("error: need 'websockets' — run: pip install websockets", file=sys.stderr)
    sys.exit(1)

DEBUG_PORT = 9223
CHATGPT_URL = "https://chatgpt.com"

async def cdp(ws, method, params=None):
    msg = {"id": 1, "method": method}
    if params:
        msg["params"] = params
    await ws.send(json.dumps(msg))
    resp = await ws.recv()
    return json.loads(resp)

async def main():
    # Find the tab pointing at ChatGPT (waits for it to appear)
    target = None
    for _ in range(20):
        tabs = json.loads(
            urllib.request.urlopen(f"http://localhost:{DEBUG_PORT}/json").read()
        )
        target = next(
            (t for t in tabs if t.get("type") == "page" and "chatgpt.com" in t.get("url", "")),
            None,
        )
        if target:
            break
        await asyncio.sleep(0.5)

    if target is None:
        pages = [t for t in tabs if t.get("type") == "page"]
        target = pages[0] if pages else tabs[0]
    ws_url = target["webSocketDebuggerUrl"]

    async with websockets.connect(ws_url) as ws:
        await cdp(ws, "Page.enable")
        await cdp(ws, "Runtime.enable")

        await cdp(ws, "Page.navigate", {"url": CHATGPT_URL})

        for _ in range(60):
            result = await cdp(ws, "Runtime.evaluate", {
                "expression": "document.readyState",
                "returnByValue": True,
            })
            state = result.get("result", {}).get("result", {}).get("value", "")
            if state == "complete":
                break
            await asyncio.sleep(0.5)

        await asyncio.sleep(3)

        # Try clicking the voice button
        js = """
        (() => {
            const selectors = [
                '[data-testid="composer-speech-button"]',
                'button[aria-label*="Voice" i]',
                'button[aria-label*="voice" i]',
                '[data-testid="voice-button"]',
                'button[aria-label="Start voice" i]',
                'button[data-testid="send-button"] + button',
            ];
            for (const sel of selectors) {
                const el = document.querySelector(sel);
                if (el) { el.click(); return sel; }
            }
            return null;
        })()
        """
        result = await cdp(ws, "Runtime.evaluate", {
            "expression": js,
            "returnByValue": True,
        })
        val = result.get("result", {}).get("result", {}).get("value", "not-found")

        if val:
            print(f"voice button clicked: {val}")
            print("ChatGPT voice mode running")
        else:
            # Voice button not found — probably not logged in
            print("=" * 60)
            print("Voice button not found — log in to ChatGPT in the window,")
            print("then re-run this script.")
            print("=" * 60)

asyncio.run(main())
PYEOF

echo "PID: $HELIUM_PID — kill with: kill $HELIUM_PID"
