#!/usr/bin/env bash
set -euo pipefail

# Snapshot of opencode2 agents for the quickshell bar, using the same
# technique as ramo: two live V2 API calls (v2.session.list,
# v2.session.active) plus tmux pane enumeration. Open TUI panes with no
# session yet are published as synthetic "New session" agents, so a
# fresh TUI shows up before its first message.

LIVE_AFTER_MS=$((30 * 60 * 1000))

oc_bin() {
    command -v opencode2 || command -v opencode
}

pid_is_descendant() {
    local descendant="$1"
    local ancestor="$2"
    local current="$descendant"
    local parent
    local depth=0

    [[ "$ancestor" =~ ^[1-9][0-9]*$ ]] || return 1
    while [[ -n "$current" && "$current" != "$ancestor" ]] && ((depth < 32)); do
        parent=$(ps -o ppid= -p "$current" 2>/dev/null | tr -d ' ')
        [[ -n "$parent" && "$parent" != "$current" ]] || return 1
        current="$parent"
        depth=$((depth + 1))
    done
    [[ "$current" == "$ancestor" ]]
}

matching_client() {
    local win_pid="$1"
    shift
    local client_pid

    for client_pid in "$@"; do
        if pid_is_descendant "$client_pid" "$win_pid"; then
            printf '%s\n' "$client_pid"
            return 0
        fi
    done
    return 1
}

active_pane_tty() {
    local win_pid client_pid client_session session pane_tty active_ws
    local -a client_pids=()
    declare -A client_sessions=()

    command -v hyprctl >/dev/null 2>&1 || return 1
    command -v tmux >/dev/null 2>&1 || return 1

    while IFS=',' read -r client_pid client_session; do
        [[ "$client_pid" =~ ^[0-9]+$ ]] || continue
        client_pids+=("$client_pid")
        client_sessions[$client_pid]="$client_session"
    done < <(tmux list-clients -F '#{client_pid},#{client_session}' 2>/dev/null || true)

    ((${#client_pids[@]} > 0)) || return 1

    win_pid=$(hyprctl activewindow -j 2>/dev/null | jq -r '.pid // 0' 2>/dev/null || true)
    client_pid=$(matching_client "$win_pid" "${client_pids[@]}" || true)
    if [[ -z "$client_pid" ]]; then
        active_ws=$(hyprctl activeworkspace -j 2>/dev/null | jq -r '.id // 0' 2>/dev/null || true)
        [[ "$active_ws" =~ ^-?[0-9]+$ ]] || return 1
        win_pid=$(hyprctl clients -j 2>/dev/null | jq -r --argjson ws "$active_ws" \
            '[.[] | select(.focusHistoryID == 1 and .workspace.id == $ws)] | .[0].pid // 0' 2>/dev/null || true)
        client_pid=$(matching_client "$win_pid" "${client_pids[@]}" || true)
    fi
    [[ -n "$client_pid" ]] || return 1

    session="${client_sessions[$client_pid]}"
    [[ -n "$session" ]] || return 1

    pane_tty=$(tmux list-panes -t "$session" -F '#{pane_tty},#{pane_active}' 2>/dev/null | awk -F ',' '$2 == "1" {print $1; exit}')
    [[ -n "$pane_tty" ]] || return 1
    printf '%s\n' "$pane_tty"
}

is_tui_process() {
    local pid="$1"
    local tty
    local -a args=()

    tty=$(readlink "/proc/$pid/fd/0" 2>/dev/null || true)
    [[ "$tty" == /dev/pts/* || "$tty" == /dev/tty* ]] || return 1
    mapfile -d '' -t args <"/proc/$pid/cmdline" || return 1
    [[ ${#args[@]} -gt 0 ]] || return 1

    if [[ ${args[1]:-} == "--version" || ${args[1]:-} == "--help" ]]; then
        return 1
    fi

    case "${args[1]:-}" in
        run|serve|web|acp|auth|models|agent|debug|stats|export|import|upgrade|uninstall|completion|mcp|github|pr|session|plugin)
            return 1
            ;;
    esac
    return 0
}

# "tty|pid|startTicks" lines for every live opencode TUI process.
tui_procs() {
    local pid tty ticks

    for pid in $(pgrep -f "opencode2" 2>/dev/null || true); do
        is_tui_process "$pid" || continue
        tty=$(readlink "/proc/$pid/fd/0" 2>/dev/null || true)
        [[ -n "$tty" ]] || continue
        ticks=$(awk '{print $22}' "/proc/$pid/stat" 2>/dev/null || true)
        printf '%s|%s|%s\n' "$tty" "$pid" "${ticks:-0}"
    done
}

# Newest-first "ticks|pane_id|tty|tmux_session|window_id" lines for TUI
# panes rooted at $1/$2. Used by focus when a record has no tty.
tui_panes_for_dir() {
    local directory="$1" real_dir="$2"
    local pid tty cwd ticks pane_line pane_id tmux_session window_id

    for pid in $(pgrep -f "opencode2" 2>/dev/null || true); do
        is_tui_process "$pid" || continue
        tty=$(readlink "/proc/$pid/fd/0" 2>/dev/null || true)
        [[ -n "$tty" ]] || continue
        cwd=$(readlink "/proc/$pid/cwd" 2>/dev/null || true)
        [[ "$cwd" == "$directory" || "$cwd" == "$real_dir" ]] || continue
        ticks=$(awk '{print $22}' "/proc/$pid/stat" 2>/dev/null || true)
        pane_line=$(tmux list-panes -a -F '#{pane_tty}|#{pane_id}|#{session_name}|#{window_id}' 2>/dev/null | awk -F '|' -v tty="$tty" '$1 == tty {print; exit}')
        [[ -n "$pane_line" ]] || continue
        IFS='|' read -r _tty pane_id tmux_session window_id <<<"$pane_line"
        printf '%s|%s|%s|%s|%s\n' "${ticks:-0}" "$pane_id" "$tty" "$tmux_session" "$window_id"
    done | sort -rn
}

focus_tmux_pane() {
    local pane_id="$1" tmux_session="$2" window_id="$3"
    local client_line="" client_session client_tty client_pid client_activity client_address best_address="" best_activity=-1

    while IFS=',' read -r client_session client_tty client_pid client_activity; do
        client_address=$(hypr_ancestor_address "$client_pid" || true)
        [[ -n "$client_address" ]] || continue
        # Prefer a client already showing this tmux session.
        if [[ "$client_session" == "$tmux_session" ]]; then
            client_line="$client_session"$'\t'"$client_tty"$'\t'"$client_pid"
            best_address="$client_address"
            break
        fi
        if ((client_activity > best_activity)); then
            best_activity=$client_activity
            client_line="$client_session"$'\t'"$client_tty"$'\t'"$client_pid"
            best_address="$client_address"
        fi
    done < <(tmux list-clients -F '#{client_session},#{client_tty},#{client_pid},#{client_activity}' 2>/dev/null || true)

    [[ -n "$client_line" ]] || return 1
    IFS=$'\t' read -r client_session client_tty client_pid <<<"$client_line"
    tmux switch-client -c "$client_tty" -t "$tmux_session" >/dev/null 2>&1 || return 1
    tmux select-window -t "$window_id" >/dev/null 2>&1 || return 1
    tmux select-pane -t "$pane_id" >/dev/null 2>&1 || return 1
    focus_hypr_address "$best_address"
}

hypr_ancestor_address() {
    local current="$1"
    local clients address parent

    command -v hyprctl >/dev/null 2>&1 || return 1
    clients=$(hyprctl clients -j 2>/dev/null) || return 1
    while [[ "$current" =~ ^[0-9]+$ ]] && ((current > 1)); do
        address=$(jq -r --argjson pid "$current" 'first(.[] | select(.pid == $pid) | .address) // empty' <<<"$clients")
        if [[ -n "$address" ]]; then
            printf '%s\n' "$address"
            return 0
        fi
        parent=$(ps -o ppid= -p "$current" 2>/dev/null | tr -d ' ')
        [[ -n "$parent" && "$parent" != "$current" ]] || break
        current="$parent"
    done
    return 1
}

focus_hypr_address() {
    local address="$1"

    hyprctl dispatch "hl.dsp.focus({ window = 'address:$address' })" >/dev/null
}

focus_hypr_ancestor() {
    local address

    address=$(hypr_ancestor_address "$1") || return 1
    focus_hypr_address "$address"
}

snapshot() {
    local now dir oc db
    local f_list f_active f_blocked f_sum f_panes f_tuis f_roots f_clients f_final
    local pane_line pane_id pane_tty tsession twin pcmd pcmd_base ppath
    local tty tpid tticks matched rid rdir

    command -v jq >/dev/null 2>&1 || {
        printf '{"ok":false,"error":"jq is required"}\n'
        return 1
    }
    oc=$(oc_bin) || {
        printf '{"ok":false,"error":"opencode CLI not found"}\n'
        return 1
    }
    db="${XDG_DATA_HOME:-$HOME/.local/share}/opencode/opencode.db"

    now=$(date +%s%3N)
    dir=$(mktemp -d) || return 1
    trap 'rm -rf "$dir"' RETURN

    f_list="$dir/list" f_active="$dir/active" f_perm="$dir/perm" f_form="$dir/form" f_blocked="$dir/blocked" f_sum="$dir/sum"
    f_panes="$dir/panes" f_tuis="$dir/tuis" f_roots="$dir/roots" f_roots_tab="$dir/roots.tab"
    f_clients="$dir/clients" f_final="$dir/final"
    : >"$f_clients"
    : >"$f_final"

    # Live V2 queries in parallel; every snapshot is fresh.
    ( "$oc" api v2.session.list --param limit=500 >"$f_list" 2>/dev/null ) &
    ( "$oc" api v2.session.active >"$f_active" 2>/dev/null ) &
    ( "$oc" api v2.permission.request.list >"$f_perm" 2>/dev/null ) &
    ( "$oc" api v2.form.request.list >"$f_form" 2>/dev/null ) &
    ( sqlite3 -json "$db" \
        'SELECT id, summary_additions AS a, summary_deletions AS d FROM session_v2 WHERE time_archived IS NULL' 2>/dev/null \
        | jq -c 'map({key: .id, value: {a: (.a // 0), d: (.d // 0)}}) | from_entries' >"$f_sum" ) &
    wait || true
    jq -cs '[.[].data[]?.sessionID] | unique' "$f_perm" "$f_form" >"$f_blocked" 2>/dev/null || : >"$f_blocked"

    tmux list-panes -a -F '#{pane_id}|#{pane_tty}|#{session_name}|#{window_id}|#{pane_current_command}|#{pane_current_path}' >"$f_panes" 2>/dev/null || true
    tui_procs >"$f_tuis"

    # Root agents: family grouping, live state, diff summaries. Sorted
    # newest-updated first for the pane matcher.
    jq -cnr --slurpfile S "$f_list" --slurpfile A "$f_active" --slurpfile B "$f_blocked" --slurpfile SUM "$f_sum" --argjson now "$now" --argjson liveAfterMs "$LIVE_AFTER_MS" '
        ($S[0].data // []) as $S
        | ($A[0].data // {}) as $A
        | ($B[0] // []) as $B
        | ($SUM[0] // {}) as $SUM
        | ($S | map(.id)) as $ids
        | ($S | group_by(.parentID // "") | map({key: (.[0].parentID // ""), value: map(.id)}) | from_entries) as $kids
        | def fam($id): [$id] + (($kids[$id] // []) | map(fam(.)) | flatten);
        def has($arr; $x): ($arr | index($x)) != null;
        def status_of($id): (($A[$id] // {}).type // "idle");
        [ $S[]
          | .parentID as $p
          | select($p == null or (($ids | index($p)) == null)) ]
        | map(. as $root
              | fam($root.id) as $fids
              | [ $S[] | select(.id as $i | has($fids; $i)) ] as $family
              | {
                  id: $root.id,
                  title: ($root.title // "New session"),
                  directory: ($root.location.directory // ""),
                  repo: (($root.location.directory // "") | split("/") | last | sub("@[^@]+$"; "")),
                  state: (
                      if any($fids[]; has($B; .)) then "blocked"
                      elif any($fids[]; status_of(.) != "idle") then "running"
                      else "idle"
                  end),
                  additions: ([$family[].id as $i | $SUM[$i].a // 0] | add // 0),
                  deletions: ([$family[].id as $i | $SUM[$i].d // 0] | add // 0),
                  activityAt: ($family | map(.time.updated // 0) | max // 0),
                  createdAt: ($root.time.created // 0),
                  updated: ($family | map(.time.updated // 0) | max // 0)
              })
        | sort_by(-.updated)
        | .[]
        | del(.updated)
    ' >"$f_roots"
    jq -r '[.id, .directory] | @tsv' "$f_roots" >"$f_roots_tab" 2>/dev/null || : >"$f_roots_tab"

    # Git branch per session directory.
    jq -Rn '[inputs | sub("\t$"; "") | split("\t")] | map({key: .[0], value: .[1]}) | from_entries' <(
        cut -f2 "$f_roots_tab" | sort -u | while read -r rdir; do
            [[ -n "$rdir" && -d "$rdir" ]] || continue
            rbranch=$(git -C "$rdir" branch --show-current 2>/dev/null || true)
            [[ -n "$rbranch" ]] && printf '%s\t%s\n' "$rdir" "$rbranch"
        done
    ) >"$dir/branches" 2>/dev/null || : >"$dir/branches"
    jq -c --slurpfile BR "$dir/branches" '($BR[0] // {}) as $BR | .directory as $d | . + {branch: ($BR[$d] // "")}' "$f_roots" >"$f_roots.2" \
        && mv "$f_roots.2" "$f_roots"

    # Open TUI panes: match each to the newest-updated root whose
    # directory contains the pane path (ramo's heuristic, one-to-one).
    # Panes with no session yet become synthetic agents so a fresh TUI
    # is visible before its first message.
    declare -A used=()
    declare -A tty_pid=()
    while IFS='|' read -r tty tpid _tticks; do
        [[ -n "$tty" ]] && tty_pid[$tty]="$tpid"
    done <"$f_tuis"

    while IFS='|' read -r pane_id pane_tty tsession twin pcmd ppath; do
        [[ -n "$pane_id" ]] || continue
        pcmd_base=${pcmd##*/}
        [[ "$pcmd_base" == opencode || "$pcmd_base" == opencode2 || "$pcmd_base" == opencode.exe || "$pcmd_base" == opencode2.exe ]] || continue
        tpid=${tty_pid[$pane_tty]:-0}

        matched=""
        while IFS=$'\t' read -r rid rdir; do
            [[ -n "$rid" && -z ${used[$rid]:-} && -n "$rdir" ]] || continue
            if [[ "$ppath" == "$rdir" || "$ppath" == "$rdir"/* ]]; then
                used[$rid]=1
                matched=$rid
                break
            fi
        done <"$f_roots_tab"

        if [[ -n "$matched" ]]; then
            jq -cn --arg root "$matched" --argjson pid "$tpid" --arg tty "$pane_tty" --argjson at "$now" \
                '{root: $root, client: {pid: $pid, tty: $tty, heartbeatAt: $at, source: "pane"}}' >>"$f_clients"
        else
            jq -cn --arg pane "$pane_id" --arg tsession "$tsession" --argjson pid "$tpid" --arg tty "$pane_tty" \
                --arg path "$ppath" --argjson at "$now" '
                {
                    id: ("synthetic:" + $tsession + ":" + $pane),
                    title: "New session",
                    directory: $path,
                    repo: ($path | split("/") | last),
                    branch: "",
                    state: "idle",
                    additions: 0,
                    deletions: 0,
                    activityAt: $at,
                    createdAt: $at,
                    clients: [{pid: $pid, tty: $tty, heartbeatAt: $at, source: "pane"}]
                }' >>"$f_final"
        fi
    done <"$f_panes"

    active_tty=$(active_pane_tty || true)

    jq -cs --slurpfile R "$f_roots" --slurpfile C "$f_clients" --argjson generatedAt "$now" --arg activeTty "$active_tty" --argjson liveAfterMs "$LIVE_AFTER_MS" '
        ($R) as $roots
        | ($C) as $clients
        | ([ $roots[]
            | . as $agent
            | . + {clients: [$clients[] | select(.root == $agent.id) | .client] } ] + .)
        # A root is published when a TUI pane shows it, it needs
        # attention, or it was touched recently.
        | map(select(
            (.clients | length) > 0
            or (.state != "idle")
            or ($generatedAt - (.activityAt // 0) < $liveAfterMs)
          ))
        | sort_by(.id)
        | {ok: true, generatedAt: $generatedAt, agents: ., activeAgentId: (
            if $activeTty == "" then null
            else ([.[] | select(any(.clients[]?; .tty == $activeTty)) | .id] | .[0])
            end
        )}
    ' <"$f_final"
}

focus_agent() {
    local session_id="$1"
    local directory real_dir oc pane_line best_ticks best_pane best_tty best_session best_window

    # Light path: a full snapshot is unnecessary for travel. Synthetic
    # ids carry the tmux pane; real sessions need one v2.session.get.
    if [[ "$session_id" == synthetic:* ]]; then
        local pane_id=${session_id##*:}
        pane_line=$(tmux list-panes -a -F '#{pane_id}|#{session_name}|#{window_id}' 2>/dev/null | awk -F '|' -v p="$pane_id" '$1 == p {print; exit}')
        if [[ -n "$pane_line" ]]; then
            IFS='|' read -r _p best_session best_window <<<"$pane_line"
            focus_tmux_pane "$pane_id" "$best_session" "$best_window"
            return
        fi
        return 1
    fi

    oc=$(oc_bin) || return 1
    directory=$("$oc" api v2.session.get --param sessionID="$session_id" 2>/dev/null | jq -r '.data.location.directory // ""' 2>/dev/null || true)
    [[ -n "$directory" ]] || return 1

    if command -v tmux >/dev/null 2>&1; then
        real_dir=$(realpath -m "$directory" 2>/dev/null || printf '%s' "$directory")
        pane_line=$(tui_panes_for_dir "$directory" "$real_dir" | head -n 1)
        if [[ -n "$pane_line" ]]; then
            IFS='|' read -r best_ticks best_pane best_tty best_session best_window <<<"$pane_line"
            if focus_tmux_pane "$best_pane" "$best_session" "$best_window"; then
                return 0
            fi
        fi

        # Nothing open there: open the session in a new terminal.
        if [[ -d "$directory" ]] && command -v uwsm >/dev/null 2>&1 && command -v xdg-terminal-exec >/dev/null 2>&1; then
            uwsm app -- xdg-terminal-exec opencode2 "$directory" --session "$session_id" --auto >/dev/null 2>&1 &
            return 0
        fi
    fi

    return 1
}

case "${1:-snapshot}" in
    snapshot)
        snapshot
        ;;
    focus)
        [[ -n ${2:-} ]] || exit 1
        if focus_agent "$2"; then
            jq -cn --arg id "$2" '{activeAgentId: $id}'
        else
            exit 1
        fi
        ;;
    *)
        printf 'usage: opencode-agents [snapshot|focus SESSION_ID]\n' >&2
        exit 1
        ;;
esac
