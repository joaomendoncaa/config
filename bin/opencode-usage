#!/usr/bin/env bash
set -euo pipefail

USAGE_URL='https://opencode.ai/zen/go/v1/usage'
ACCOUNT_FILE="$HOME/.local/share/opencode/account.json"
CRED_DB="${XDG_DATA_HOME:-$HOME/.local/share}/opencode/opencode.db"

fail() {
    jq -cn --arg error "$1" '{ok: false, error: $error}'
    exit 1
}

command -v jq >/dev/null 2>&1 || { printf '{"ok":false,"error":"jq is required"}\n'; exit 1; }

# Live credential store first (what `opencode auth login` maintains),
# legacy account.json only as fallback.
api_key=""
if command -v sqlite3 >/dev/null 2>&1 && [[ -f "$CRED_DB" ]]; then
    api_key=$(sqlite3 "$CRED_DB" "PRAGMA busy_timeout=3000; SELECT json_extract(value, '\$.key') FROM credential WHERE active = 1 AND integration_id IN ('opencode-go', 'opencode') ORDER BY CASE integration_id WHEN 'opencode-go' THEN 0 ELSE 1 END LIMIT 1;" 2>/dev/null | tail -n 1 || true)
    [[ "$api_key" == "null" ]] && api_key=""
fi
if [[ -z "$api_key" ]]; then
    api_key=$(jq -r '[.accounts[] | select(.serviceID == "opencode-go" or .serviceID == "opencode") | .credential.key] | first // empty' "$ACCOUNT_FILE") || fail 'OpenCode account is not configured'
    [[ -n $api_key ]] || fail 'OpenCode API key not found in ~/.local/share/opencode/account.json'
fi

output=$(
    curl -fsS --max-time 20 --compressed -H "Authorization: Bearer $api_key" "$USAGE_URL" |
        jq -c --argjson now "$(date +%s%3N)" '
            def norm:
                . as $w
                | ($w.resetsAt | sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601) as $reset
                | {
                    used: ($w.percent // 0),
                    percent: ($w.percent // 0),
                    status: ($w.status // "ok"),
                    resetSeconds: (((($reset * 1000) - $now) / 1000) | floor)
                };
            .usage
            | {
                ok: true,
                fetchedAt: $now,
                usage: {
                    "5h": (.rolling | norm),
                    weekly: (.weekly | norm),
                    monthly: (.monthly | norm)
                }
            }'
) || fail 'Failed to fetch OpenCode usage'

printf '%s\n' "$output"
