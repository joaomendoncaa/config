#!/usr/bin/env bash

function ghn() {
	gh repo create "$(basename "$PWD")" --private --source=. --remote=origin --push
}

function ghnp() {
	gh repo create "$(basename "$PWD")" --public --source=. --remote=origin --push
}

function gi() {
	curl -sL "https://www.toptal.com/developers/gitignore/api/$@"
}

function dlp() {
	if [[ -z "${1:-}" || -z "${2:-}" ]]; then
		echo "Usage: dlp <url> <output-name>" >&2
		return 1
	fi
	yt-dlp -o "${2}.%(ext)s" "$1"
}

function add_to_path() {
	if [[ ":$PATH:" != *":$1:"* ]]; then
		export PATH="$1:$PATH"
	fi
}

function add_to_path_rs_builds() {
	for dir in "$HOME"/lab/*/target/release "$HOME"/lab/worktrees/*/target/release; do
		[ -d "$dir" ] && add_to_path "$dir"
	done
}

# Open tmux by attaching to existing session or creating a new one.
function t() {
	if tmux has-session 2>/dev/null; then
		tmux attach
	else
		tmux new-session -s lab -c ~/lab
	fi
}

# Notify — ephemeral notification (auto-dismisses after 5s).
# Usage: notify <summary> [body] [group]
#   group: group key; replaces any existing notification with the same group
function notify() {
	local summary="$1"
	local body="${2:-}"
	local group="${3:-}"
	fyi "$summary" "$body" low 5 "" "$group"
}

# Wait for hyprland window to open.
function wait_for_window() {
	local class_pattern="$1"
	local max_wait=30
	local count=0

	while [ $count -lt $max_wait ]; do
		if hyprctl clients | grep -i "class:" | grep -i "$class_pattern" >/dev/null 2>&1; then
			return 0
		fi
		sleep 0.2
		count=$((count + 1))
	done
	return 1
}

# Launch a webapp and wait for it to open.
function launch_app() {
	local name="$1"
	local url_or_cmd="$2"
	local class_pattern="$3"
	local app_name="${4:-launcher}"
	local group="launch:$name"

	notify "Launching $name..." "" "$group"

	if [[ "$class_pattern" == "cmd:"* ]]; then
		class_pattern="${class_pattern#cmd:}"
		"$url_or_cmd" &>/dev/null &
	else
		omarchy-launch-webapp "$url_or_cmd" &>/dev/null &
	fi

	if wait_for_window "$class_pattern"; then
		notify "$name: Launched successfully" "" "$group"
	else
		notify "$name: Failed to launch" "" "$group"
		return 1
	fi
}

# ── async git dirty check (shared by PS1 + tmux status-left) ───────────────────
# Spawns a background job that writes * or empty to /tmp/git-dirty-<path>
# (path with / replaced by -). Keyed by path, not pane — same repo in two
# panes shares one file. tmux hooks call bin/git-dirty check, writing the
# same file with a shared pidfile so a stale job from either trigger is killed
# before a new one starts. Readers (PS1, tmux status-left via git-dirty read)
# read the file synchronously (instant). Result is one cycle behind.

__git_dirty_char() {
	[[ -s "/tmp/git-dirty-${PWD//\//-}" ]] && printf ' *'
}

__git_async_check() {
	local file="/tmp/git-dirty-${PWD//\//-}"
	local pidfile="$file.pid"
	[[ -f "$pidfile" ]] && kill "$(cat "$pidfile")" 2>/dev/null || true

	(
		cd "$PWD" 2>/dev/null || exit
		git rev-parse --git-dir &>/dev/null || {
			: >"$file"
			exit
		}

		local dirty
		dirty=$(git status --porcelain 2>/dev/null)
		if [[ -n "$dirty" ]]; then
			printf '*' >"$file"
		else
			: >"$file"
		fi
	) &>/dev/null &
	echo $! >"$pidfile"
	disown
}

# Quick compress pass on a video
compress() {
	f="$1"
	TARGET_MB=10
	AUDIO_K=128
	D=$(ffprobe -v error -show_entries format=duration -of csv=p=0 "$f")
	B=$(echo "$TARGET_MB*8192/$D-$AUDIO_K" | bc)
	ffmpeg -i "$f" -c:v libx264 -b:v ${B}k -c:a aac -b:a ${AUDIO_K}k "${f%.*}_compressed.mp4"
}
